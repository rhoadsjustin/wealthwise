{
  "expo": {
    "name": "WealthWise",
    "slug": "budget-app",
    "version": "1.0.0",
    "scheme": "budget-app",
    "newArchEnabled": true,
    "web": {
      "bundler": "metro",
      "output": "server",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "expo-document-picker",
      "expo-sqlite",
      "expo-secure-store",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access screenshots and receipt photos for transaction import.",
          "cameraPermission": "Allow $(PRODUCT_NAME) to capture receipts and statements for transaction import.",
          "microphonePermission": false
        }
      ],
      [
        "./modules/apple-finance-kit/app.plugin.js",
        {
          "enabled": false,
          "usageDescription": "Allow $(PRODUCT_NAME) to read Apple Wallet financial data so it can import your Apple Card transactions and balances into your budget."
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "17.4"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    },
    "orientation": "portrait",
    "icon": "./assets/app-icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/wealth_wise_splash_4096.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "icon": "./assets/WealthWise.icon",
      "supportsTablet": false,
      "bundleIdentifier": "com.rhoadsjustin.budgetapp",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.rhoadsjustin.budgetapp"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8c4944ab-4105-4de0-ab9d-7861d865cb7b"
      }
    }
  }
}
